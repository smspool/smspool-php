{
    "name": "smspool/smspool-php",
    "description": "Official PHP client for the SMSPool API: SMS verification numbers, rentals, pre-orders and eSIMs.",
    "keywords": [
        "smspool",
        "sms",
        "sms-verification",
        "otp",
        "phone-verification",
        "api",
        "sdk"
    ],
    "homepage": "https://api.smspool.net/docs",
    "license": "MIT",
    "authors": [
        {
            "name": "SMSPool",
            "homepage": "https://www.smspool.net"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "SMSPool\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SMSPool\\Test\\": "test/"
        }
    },
    "support": {
        "issues": "https://github.com/smspool/smspool-php/issues",
        "docs": "https://api.smspool.net/docs"
    }
}
